# Official-PHP oracle for gocomposer comparisons. The base is pinned by digest
# (recorded in docs/validation); only tools Composer itself shells out to are added.
ARG PHP_IMAGE
FROM ${PHP_IMAGE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends git unzip ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 oracle
USER oracle
WORKDIR /work
