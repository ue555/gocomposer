{
    "name": "gocomposer/integration-plugin-php-http-discovery",
    "description": "Integration fixture: php-http/discovery pinned implementation (pre-autoload-dump plugin)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php-http/discovery": "^1.20",
        "nyholm/psr7": "^1.8"
    },
    "extra": {
        "discovery": {
            "psr/http-factory-implementation": "Nyholm\\Psr7\\Factory\\Psr17Factory"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
