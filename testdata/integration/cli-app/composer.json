{
    "name": "gocomposer-it/cli-app",
    "description": "Fixed CLI application used by gocomposer integration tests",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.4",
        "monolog/monolog": "^3.9",
        "guzzlehttp/guzzle": "^7.10",
        "nesbot/carbon": "^3.10"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"},
        "files": ["src/helpers.php"],
        "classmap": ["src/Legacy/"]
    },
    "bin": ["bin/app"],
    "scripts": {
        "post-install-cmd": ["@php bin/app greet --name=install"],
        "post-update-cmd": ["@php bin/app greet --name=update"]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": false
    }
}
