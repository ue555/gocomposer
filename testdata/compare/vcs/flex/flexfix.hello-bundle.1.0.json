{
    "manifests": {
        "flexfix/hello-bundle": {
            "manifest": {
                "bundles": {
                    "Flexfix\\HelloBundle\\FlexfixHelloBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "env": {
                    "HELLO_GREETING": "hi"
                },
                "gitignore": [
                    "/%VAR_DIR%/hello/"
                ],
                "post-install-output": [
                    "  * <fg=blue>Configure</> the greeting in <comment>%CONFIG_DIR%/packages/hello.yaml</>"
                ]
            },
            "files": {
                "config/packages/hello.yaml": {
                    "contents": [
                        "hello:",
                        "    greeting: '%env(HELLO_GREETING)%'"
                    ],
                    "executable": false
                }
            },
            "ref": "2a2b2c2d2e2f303132333435363738393a3b3c3d"
        }
    }
}
